{
  "targets": {
    "i386-win32": {
      "cpu": "i386",
      "os": "win32",
      "display_name": "Windows 32-bit",
      "fpc_target": "i386-win32",
      "cross_options": "",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "i686-w64-mingw32-",
        "acquisition": "system-package",
        "package_hint": {
          "debian": "mingw-w64",
          "fedora": "mingw32-gcc",
          "brew": "mingw-w64"
        }
      },
      "build": {
        "steps": [
          {"action": "make", "targets": ["crossall"], "env": {"CPU_TARGET": "{{cpu}}", "OS_TARGET": "{{os}}", "CROSSOPT": "{{cross_options}}", "PP": "{{host_compiler}}"}},
          {"action": "make", "targets": ["crossinstall"], "env": {"CPU_TARGET": "{{cpu}}", "OS_TARGET": "{{os}}", "PREFIX": "{{install_path}}"}}
        ]
      }
    },
    "x86_64-win64": {
      "cpu": "x86_64",
      "os": "win64",
      "display_name": "Windows 64-bit",
      "fpc_target": "x86_64-win64",
      "cross_options": "",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "x86_64-w64-mingw32-",
        "acquisition": "system-package",
        "package_hint": {
          "debian": "mingw-w64",
          "brew": "mingw-w64"
        }
      },
      "build": {"inherit": "i386-win32"}
    },
    "arm-linux": {
      "cpu": "arm",
      "os": "linux",
      "display_name": "ARM Linux (hard-float)",
      "fpc_target": "arm-linux",
      "subarch": "armv7a",
      "cross_options": "-CpARMV7A -CfVFPV3",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "arm-linux-gnueabihf-",
        "acquisition": "system-package",
        "package_hint": {
          "debian": "gcc-arm-linux-gnueabihf",
          "fedora": "arm-linux-gnueabihf-gcc"
        }
      },
      "build": {"inherit": "i386-win32"}
    },
    "aarch64-linux": {
      "cpu": "aarch64",
      "os": "linux",
      "display_name": "ARM64 Linux",
      "fpc_target": "aarch64-linux",
      "cross_options": "",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "aarch64-linux-gnu-",
        "acquisition": "system-package",
        "package_hint": {
          "debian": "gcc-aarch64-linux-gnu"
        }
      },
      "build": {"inherit": "i386-win32"}
    },
    "x86_64-darwin": {
      "cpu": "x86_64",
      "os": "darwin",
      "display_name": "macOS Intel",
      "fpc_target": "x86_64-darwin",
      "cross_options": "",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "",
        "acquisition": "xcode"
      },
      "build": {"inherit": "i386-win32"}
    },
    "aarch64-darwin": {
      "cpu": "aarch64",
      "os": "darwin",
      "display_name": "macOS Apple Silicon",
      "fpc_target": "aarch64-darwin",
      "cross_options": "",
      "requires_fpc": ">=3.2.2",
      "binutils": {
        "prefix": "",
        "acquisition": "xcode"
      },
      "build": {"inherit": "i386-win32"}
    },
    "arm-android": {
      "cpu": "arm",
      "os": "android",
      "display_name": "Android ARM 32-bit",
      "fpc_target": "arm-android",
      "cross_options": "-CpARMV7A -CfVFPV3",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "arm-linux-androideabi-",
        "acquisition": "ndk"
      },
      "build": {"inherit": "i386-win32"}
    },
    "aarch64-android": {
      "cpu": "aarch64",
      "os": "android",
      "display_name": "Android ARM 64-bit",
      "fpc_target": "aarch64-android",
      "cross_options": "",
      "requires_fpc": ">=3.2.0",
      "binutils": {
        "prefix": "aarch64-linux-android-",
        "acquisition": "ndk"
      },
      "build": {"inherit": "i386-win32"}
    },
    "aarch64-ios": {
      "cpu": "aarch64",
      "os": "ios",
      "display_name": "iOS ARM64",
      "fpc_target": "aarch64-ios",
      "cross_options": "",
      "requires_fpc": ">=3.2.2",
      "binutils": {
        "prefix": "",
        "acquisition": "xcode"
      },
      "build": {"inherit": "i386-win32"}
    }
  }
}
